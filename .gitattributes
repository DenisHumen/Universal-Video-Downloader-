# The package scripts and the AppArmor profile are read on Linux, where a
# carriage return is part of the line: bash stops at `$'\r': command not found`
# and a Windows checkout with core.autocrlf would hand it exactly that.
build/linux/* text eol=lf
# Read by bash and makepkg on Linux runners, for the same reason.
*.sh text eol=lf
packaging/aur/PKGBUILD text eol=lf
